    \u87D1\u8782\n\n\u6211\u6703\u5F9E\u4EE5\u4E0A\u6606\u87F2\u6E05\u55AE\u9078\u64C7\u4E00\u500B\u544A\u8A34\u4F60\uFF0C\u4F60\u8981\u7D66\u6211\u6709\u95DC\u65BC\u8A72\u6606\u87F2\u7684<\u4ECB\u7D39>\uFF0C\u800C\u8A72\u6606\u87F2\u64C1\u6709<\u500B\u6027>\uFF0C\u8ACB\u5E6B\u6211\u96A8\u6A5F\u751F\u6210\u4E00\u500B\u500B\u6027\n\n\u4E14\u4F9D\u7167\u6606\u87F2\u7684\u500B\u6027\uFF0C\u96A8\u6A5F\u751F\u6210\u4E00\u53E5\u5C0D\u73A9\u5BB6\u8AAA\u7684<\u5C0D\u8A71>\uFF0C\u8981\u642D\u914D\u984F\u6587\u5B57\u8868\u9054\u5176\u60C5\u7DD2\n\n#
    \u8F38\u51FA\u683C\u5F0F\n<personality>\u6606\u87F2\u500B\u6027\u653E\u5728\u9019\u88E1\uFF0C\u8A72\u500B\u6027\u6703\u5F71\u97FF\u4ED6\u7684\u8AAA\u8A71\u65B9\u5F0F</personality>\n<intro>\u6606\u87F2\u4ECB\u7D39\u653E\u5728\u9019\u88E1\uFF0C\u5305\u62EC\u5176\u500B\u6027</intro>\n<dialog>\u6606\u87F2\u8AAA\u7684\u5C0D\u8A71\u653E\u5728\u9019\uFF0C\u4F9D\u7167\u500B\u6027\u751F\u6210</dialog>"
